{
  "name": "swedeline",
  "version": "0.1.0",
  "private": true,
  "description": "Learn Swedish while you browse: replaces some words on English, German, French and Spanish pages with Swedish translations.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "watch": "node scripts/build.mjs --watch",
    "dicts": "node scripts/build-dicts.mjs",
    "dict-report": "node scripts/dict-report.mjs",
    "icons": "node scripts/build-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint:firefox": "web-ext lint -s dist/firefox",
    "run:firefox": "web-ext run -s dist/firefox",
    "zip": "node scripts/zip.mjs",
    "harness": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0"
  }
}
